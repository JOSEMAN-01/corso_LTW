<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <!--Voglio un elemento che può contenere solo del testo, e che può avere un attributo-->

    <xs:element name="persona">
        <xs:complexType>
            <xs:simpleContent>
                <xs:extension base="xs:string">
                    <xs:attribute name="eta" />
                </xs:extension>
            </xs:simpleContent>
        </xs:complexType>
    </xs:element>



</xs:schema>
